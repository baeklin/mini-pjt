# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# AWS Bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 자격증명을 쓸 때만 채운다
AWS_SESSION_TOKEN=
# 에이전트·채점용 LLM (예: Claude Sonnet 계열 모델 ID 또는 추론 프로파일 ID)
BEDROCK_MODEL_ID=
# 1순위 모델이 쓰로틀링 등으로 실패할 때 순서대로 쓸 대체 모델 (쉼표 구분, 비우면 폴백 없음)
BEDROCK_FALLBACK_MODEL_IDS=
# 임베딩 모델 (예: amazon.titan-embed-text-v2:0)
BEDROCK_EMBED_MODEL_ID=

# 평가 재현성을 위한 기준 날짜 (비우면 실제 오늘 날짜)
TODAY=2026-11-04

# LangSmith 트레이스
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-parenting-helper
